{
  "name": "dsh-restart-handoff",
  "version": "0.2.3",
  "type": "module",
  "main": "./index.js",
  "description": "Restart the Harness itself and come back: a dedicated restart_dsh tool hands the session over to the next process, which resumes it, replays the pending instruction and wakes the subagents again.",
  "license": "MIT",
  "author": "sadkga",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadkga/dsh-restart-handoff.git"
  },
  "homepage": "https://github.com/sadkga/dsh-restart-handoff#readme",
  "bugs": {
    "url": "https://github.com/sadkga/dsh-restart-handoff/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "resume",
    "handoff"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs",
    "test"
  ],
  "engines": {
    "node": ">=24.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
